# dependensi
node_modules/
.npm-cache/

# data runtime: sesi login WhatsApp, database JSON/SQLite, cache, cadangan
data/
*.log

# konfigurasi lokal (berisi password dashboard & API key) — salin dari config/config.example.json
config/config.json

# file sementara & berkas sensitif plugin classic / extra
tmp/
src/bin/cookies.txt
src/bin/yt-dlp*
# data runtime plugin classic/engine (dibuat otomatis saat bot berjalan; berisi data pengguna)
src/database/*
!src/database/.gitkeep
src/plugins/.stage/

# hasil graphify (dibangun ulang dengan `npm run graph`)
graphify-out/

# dashboard Next.js: sumber di dashboard/src, hasil build statis (dashboard/out) ikut di-commit
dashboard/.next/
dashboard/next-env.d.ts
