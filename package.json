{
  "name": "xorizn-bot",
  "version": "2.0.0",
  "description": "xorizn-bot — WhatsApp bot modular (Baileys v7) + dashboard localhost, ±2.400 perintah, database JSON / SQLite / MySQL (XAMPP).",
  "type": "module",
  "main": "src/index.js",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/launcher.js",
    "start:raw": "node src/index.js",
    "dev": "node --watch-path=src/core --watch-path=src/features --watch-path=src/compat --watch-path=src/dashboard --watch-path=src/utils --watch-path=src/plugins/core src/index.js",
    "check": "node src/index.js --no-connect",
    "reset-session": "node src/tools/reset-session.js",
    "graph": "graphify update .",
    "build:dashboard": "npm --prefix dashboard install && npm --prefix dashboard run build"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "dashboard",
    "multi-device"
  ],
  "author": "denis-putra",
  "license": "ISC",
